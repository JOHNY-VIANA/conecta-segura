# Copy to .env locally. Configure equivalent encrypted runtime variables on hosting.
# Never commit the real .env. Live mode is intentionally OFF by default.
LIVE_ALERTS_ENABLED=false
# Public browser Firebase config. Activate Google and Phone providers and authorized domains.
FIREBASE_PUBLIC_CONFIG={"apiKey":"","authDomain":"","projectId":"","appId":""}
# Browser key: restrict to Maps JavaScript API and exact production HTTP referrers.
GOOGLE_MAPS_BROWSER_KEY=
# Secret: only server-side. Enable Brazil messaging destinations and account billing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Approved WhatsApp Business sender with whatsapp: prefix; destination opt-in required.
TWILIO_WHATSAPP_FROM=
# Approved Content Template: {{1}}=person name; {{2}}=emergency; {{3}}=map URL or unavailable.
TWILIO_WHATSAPP_CONTENT_SID=
# Backend: origens HTTPS exatas autorizadas, separadas por vírgula, sem caminho ou *.
ALLOWED_ORIGINS=
# Build estático: origem HTTPS do backend externo. Vazio mantém somente demonstração.
# Configure como variável do repositório/ambiente de build, nunca como segredo no JS.
PAGES_API_BASE_URL=
